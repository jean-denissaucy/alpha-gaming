PORT=5000
# Si MySQL est sur Plesk et le backend sur Render, ne pas utiliser localhost.
DB_HOST=mysql.example.com
DB_PORT=3306
DB_USER=plesk_mysql_user
DB_PASSWORD=plesk_mysql_password
DB_NAME=plesk_database_name
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app
# Liste d'adresses email autorisées à accéder à /api/admin, séparées par des virgules.
ADMIN_EMAILS=AGS@example.com